diff --git a/AutoFateGrind/Windows/Sections/Config/OceanTripSettings.cs b/AutoFateGrind/Windows/Sections/Config/OceanTripSettings.cs
new file mode 100644
index 0000000..b4d1e08
--- /dev/null
